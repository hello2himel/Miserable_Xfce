{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/alien.txt",
    "color": {"1": "green"}
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "32"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "33"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "32"
    },
    "break"
  ]
}
